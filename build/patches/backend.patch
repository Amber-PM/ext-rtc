+bool DataChannel::send(const byte *data, size_t size, shared_ptr<void> lifetime) {
+	auto message = message_ptr(new Message(data, data + size, Message::Binary),
+	    [lifetime = std::move(lifetime)](Message *message) mutable noexcept {
+		    delete message;
+		    lifetime.reset();
+	    });
+	return impl()->outgoing(std::move(message));
+}
