cmake_minimum_required(VERSION 3.19)
foreach(required ROOT SOURCE DESTINATION)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "missing ${required}")
  endif()
endforeach()
file(REAL_PATH "${ROOT}" ROOT)
file(REAL_PATH "${SOURCE}" SOURCE)
get_filename_component(DESTINATION "${DESTINATION}" REALPATH)
foreach(path SOURCE DESTINATION)
  string(FIND "${${path}}/" "${ROOT}/.build/" inside)
  if(NOT inside EQUAL 0 OR "${${path}}" STREQUAL "${ROOT}/.build")
    message(FATAL_ERROR "${path} must be a child of this repository's .build directory")
  endif()
endforeach()
file(READ "${ROOT}/build/dependencies.lock.json" lock)
string(JSON commit GET "${lock}" libdatachannel commit)
function(git_checked result)
  execute_process(COMMAND git --no-optional-locks ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "git failed: ${error}")
  endif()
  set(${result} "${output}" PARENT_SCOPE)
endfunction()
string(JSON count LENGTH "${lock}" libdatachannel patches)
math(EXPR last "${count}-1")
foreach(i RANGE ${last})
  string(JSON path GET "${lock}" libdatachannel patches ${i} path)
  string(JSON expected GET "${lock}" libdatachannel patches ${i} sha256)
  file(SHA256 "${ROOT}/${path}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "backend patch hash mismatch: ${path}")
  endif()
endforeach()
git_checked(actual -C "${SOURCE}" rev-parse HEAD)
if(NOT actual STREQUAL commit)
  message(FATAL_ERROR "backend base revision mismatch")
endif()
git_checked(dirty -C "${SOURCE}" status --porcelain --untracked-files=all)
if(NOT dirty STREQUAL "")
  message(FATAL_ERROR "backend base source is dirty")
endif()
string(JSON count LENGTH "${lock}" libdatachannel submodules)
math(EXPR last "${count}-1")
foreach(i RANGE ${last})
  string(JSON path MEMBER "${lock}" libdatachannel submodules ${i})
  string(JSON expected GET "${lock}" libdatachannel submodules "${path}")
  git_checked(actual -C "${SOURCE}/${path}" rev-parse HEAD)
  git_checked(dirty -C "${SOURCE}/${path}" status --porcelain --untracked-files=all)
  if(NOT actual STREQUAL expected OR NOT dirty STREQUAL "")
    message(FATAL_ERROR "backend submodule mismatch or dirty source: ${path}")
  endif()
endforeach()
if(EXISTS "${DESTINATION}")
  message(FATAL_ERROR "private patched source already exists; use a fresh build directory")
endif()
string(JSON count LENGTH "${lock}" libdatachannel patches)
math(EXPR last "${count}-1")
file(MAKE_DIRECTORY "${DESTINATION}")
file(COPY "${SOURCE}/" DESTINATION "${DESTINATION}" PATTERN ".git" EXCLUDE)
get_filename_component(patch_parent "${DESTINATION}" DIRECTORY)
foreach(i RANGE ${last})
  string(JSON path GET "${lock}" libdatachannel patches ${i} path)
  foreach(mode check apply)
    set(options)
    if(mode STREQUAL "check")
      list(APPEND options --check)
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "GIT_CEILING_DIRECTORIES=${patch_parent}" git -C "${DESTINATION}" apply --no-index ${options} "${ROOT}/${path}" RESULT_VARIABLE status ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "backend patch ${mode} failed: ${error}")
    endif()
  endforeach()
endforeach()
file(READ "${DESTINATION}/include/rtc/datachannel.hpp" header)
file(READ "${DESTINATION}/src/datachannel.cpp" implementation)
file(READ "${DESTINATION}/src/global.cpp" identity)
if(NOT header MATCHES "shared_ptr<void> lifetime" OR NOT implementation MATCHES "lifetime.reset\\(\\)" OR
   NOT identity MATCHES "rtcExtMessageLifetimeIdentity" OR NOT EXISTS "${DESTINATION}/include/rtc/ext_rtc_backend.h")
  message(FATAL_ERROR "backend patch application did not produce the required ownership and identity interfaces")
endif()
file(COPY "${ROOT}/build/dependencies.lock.json" DESTINATION "${DESTINATION}/ext-rtc-packaging")
